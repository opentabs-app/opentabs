{
  "name": "@opentabs/extension",
  "version": "1.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:wasm && vite build && node scripts/copy-static.mjs",
    "build:firefox": "npm run build:wasm && TARGET_BROWSER=firefox vite build && TARGET_BROWSER=firefox node scripts/copy-static.mjs",
    "android": "npm run build:firefox && web-ext run --target=firefox-android --source-dir=dist-firefox --adb-remove-old-artifacts",
    "android:devices": "web-ext run --target=firefox-android --source-dir=dist-firefox --adb-discovery-timeout 5000 || true",
    "dev": "npm run build:wasm && vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run vendor:opensync:check && vitest run",
    "vendor:opensync": "node scripts/vendor-opensync.mjs",
    "vendor:opensync:check": "node scripts/vendor-opensync.mjs --check",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "web-ext": "^10.6.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "nostr-tools": "^2.25.2"
  }
}
